{
  "manifest_version": 3,
  "name": "Tune Crate",
  "version": "1.0",
  "description": "A dark themed music player with flowing UI effects",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],
  "action": {
    "default_popup": "./popup.html",
    "default_title": "Tune Crate"
  },
  "background": {
    "service_worker": "./background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html", "offscreen.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
